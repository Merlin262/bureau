<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bureau</RootNamespace>
    <AssemblyName>bureau</AssemblyName>
    <Version>0.1.0</Version>

    <!-- Binário nativo: inicia em milissegundos e usa pouca RAM (ideal p/ notebook antigo) -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="bureau.dev.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
