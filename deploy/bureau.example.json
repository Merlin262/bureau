{
  "Port": 8420,
  "PasswordHash": "gerado por: bureau set-password",
  "DataDir": "/var/lib/bureau",
  "AllowPower": true,
  "Services": ["pihole-FTL", "docker", "ssh", "tailscaled"],
  "Docker": { "Enabled": true, "Socket": "/var/run/docker.sock" },
  "PiHole": { "Enabled": true, "Url": "http://127.0.0.1", "Password": "sua-app-password-do-pihole" },
  "Alerts": { "Enabled": true, "DiskPercent": 90, "TempCelsius": 85, "BatteryCritical": 20 },
  "Push": {
    "FcmServiceAccount": "/etc/bureau/firebase.json",
    "WebPushSubject": "mailto:voce@exemplo.com",
    "NtfyUrl": "",
    "NtfyToken": "",
    "Apns": { "KeyFile": "/etc/bureau/apns.p8", "KeyId": "ABC123DEFG", "TeamId": "XYZ987TEAM", "BundleId": "dev.bureau.app", "Sandbox": true }
  },
  "HomeAssistant": { "Enabled": true, "Url": "http://127.0.0.1:8123", "Token": "token-de-longa-duracao", "Entities": [] },
  "Jellyfin": { "Enabled": true, "Url": "http://127.0.0.1:8096", "ApiKey": "chave-de-api" },
  "Backups": [ { "Name": "Fotos", "Unit": "restic-fotos.service", "MaxAgeHours": 26 } ],
  "SystemUpdates": true,
  "Terminal": { "Enabled": false, "User": "seu-usuario-linux", "Port": 22 },
  "Telemetry": { "OtlpEndpoint": "" },
  "Logging": { "LogLevel": { "Default": "Warning", "bureau": "Information", "Microsoft.Hosting.Lifetime": "Information" } }
}
